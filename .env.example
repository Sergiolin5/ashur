# Copy to .env on the server only. Never commit real values.
# Generate each key with:  python3 -c "import secrets; print(secrets.token_urlsafe(32))"

# Lets a new device join (used once per device at install time)
ASHUR_ENROLL_KEY=
# Lets Sergio / Ashur read status, queue tasks, revoke nodes
ASHUR_ADMIN_KEY=
# Path to the SQLite file
ASHUR_DB=/data/ashur.db
# Ashur's brain (set on the server only)
ANTHROPIC_API_KEY=
ASHUR_MODEL=claude-sonnet-5-5
ASHUR_MONTHLY_BUDGET_USD=10

# OpenJarvis (pinned 1.0.4), mounted on Ashur's own queue. Every capability is off unless its flag is 1.
# Its agents never call Ollama themselves: each model call is an encargo unit sent to a device by the core.
# Telemetry is forced off and its data lives in <data dir>/openjarvis.
ASHUR_OJ_SKILLS=0
ASHUR_OJ_SKILLS_IMPORT=0
ASHUR_OJ_DEEP_RESEARCH=0
ASHUR_OJ_DIGEST=0
ASHUR_OJ_TRACES=0
ASHUR_OJ_RUTINAS_AUTO=0   # needs TRACES: at a routine's usual hour, do its low-risk steps and offer the rest
ASHUR_OJ_GMAIL=0
ASHUR_OJ_TASKS=0
ASHUR_OJ_CALENDAR=0
ASHUR_OJ_BENCH=0
# Google (Gmail, Tasks, Calendar): a desktop OAuth client, and the key that encrypts the token at rest.
# Key: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ASHUR_GOOGLE_CLIENT_ID=
ASHUR_GOOGLE_CLIENT_SECRET=
ASHUR_GOOGLE_TOKEN_KEY=
