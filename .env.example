# Copy to .env on the server only. Never commit real values.
# Generate each key with:  python3 -c "import secrets; print(secrets.token_urlsafe(32))"

# Lets a new device join (used once per device at install time)
ASHUR_ENROLL_KEY=
# Lets Sergio / Ashur read status, queue tasks, revoke nodes
ASHUR_ADMIN_KEY=
# Path to the SQLite file
ASHUR_DB=/data/ashur.db
# Ashur's brain (set on the server only)
ANTHROPIC_API_KEY=
ASHUR_MODEL=claude-sonnet-5-5
ASHUR_MONTHLY_BUDGET_USD=10
